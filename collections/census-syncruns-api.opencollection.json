              },
              {
                "name": "per_page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List sync runs"
        },
        {
          "info": {
            "name": "Get a sync run",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.getcensus.com/api/v1/sync_runs/:id",
